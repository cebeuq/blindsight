# blindsight configuration. Copy to .env next to compose.yaml (docker compose reads it from there), edit, then:
#   docker compose up -d --build --wait
# After changing a value: docker compose up -d   (recreates the affected containers)
# Syntax: KEY=value, no spaces around "=". Put values with spaces, "#", "$" or JSON in single quotes (taken literally).
# Variables set in your shell override this file. Only VISION_MODEL is required; empty values take the defaults.

# --- Pick your harness: point the client's base URL at the router. It forwards the path the client calls to TEXT_URL,
# with the client's own API key headers untouched, so the client format must be one the text API serves.
#   Anthropic-format clients (Claude Code, Anthropic SDKs):      ANTHROPIC_BASE_URL=http://127.0.0.1:8100
#   OpenAI-format clients (Chat Completions or Responses):       base URL http://127.0.0.1:8100/v1
#   Ollama-native clients (/api/chat, /api/generate):            http://127.0.0.1:8100
#   Gemini-native clients (Google GenAI SDK base URL):           http://127.0.0.1:8100
# WebSocket transports (e.g. the Responses API over WebSocket) get a 400: use the client's plain HTTP mode.
# How the model asks about an image (ASK_HINT below):
#   harness supports MCP        -> ASK_HINT=mcp and register http://127.0.0.1:8102/mcp
#                                  (Claude Code: claude mcp add --scope local --transport http vision <url>)
#   it can run shell commands   -> ASK_HINT=http (the model runs curl against ASK_URL; sandboxed harnesses must allow
#                                  network access for that, e.g. Codex's read-only sandbox blocks it)
#   neither                     -> CAPTION_MODE=detailed and ASK_HINT=none (the caption is all the model gets)

# --- Text model: base URL of the text-only model's API. http or https, optional port and path prefix, no query.
# The client's path and query are appended (client calls /v1/messages -> TEXT_URL/v1/messages); the Host header is
# this URL's host. https is verified against the system CAs (no way to turn that off). Host names other than
# host.docker.internal are re-resolved while running (hosted APIs change addresses).
# host.docker.internal = the Docker host (Docker Desktop; on Linux via the extra_hosts entry in compose.yaml). On Linux
# that is the Docker bridge address: host model servers must listen on 0.0.0.0 (or that address), not only 127.0.0.1,
# and the firewall must allow Docker's bridge networks. See README "Configuration".
# Upgrading from v1: TEXT_HOST / TEXT_PORT are no longer read; if either is set, the router exits 2 and names the
# TEXT_URL to use instead.
TEXT_URL=http://host.docker.internal:8000
# Examples (the API key is the client's own, e.g. ANTHROPIC_AUTH_TOKEN / OPENAI_API_KEY in the harness):
#   local vLLM / SGLang / llama.cpp     TEXT_URL=http://host.docker.internal:8000
#   local Ollama                        TEXT_URL=http://host.docker.internal:11434
#   DeepSeek (Anthropic format)         TEXT_URL=https://api.deepseek.com/anthropic
#   Kimi / Moonshot (Anthropic format)  TEXT_URL=https://api.moonshot.ai/anthropic
#   GLM / Z.ai (Anthropic format)       TEXT_URL=https://api.z.ai/api/anthropic
#   OpenRouter (OpenAI format)          TEXT_URL=https://openrouter.ai/api      (client base http://127.0.0.1:8100/v1)
#   Groq (OpenAI format)                TEXT_URL=https://api.groq.com/openai    (client base http://127.0.0.1:8100/v1)

# Optional PEM CA bundle that replaces the system CAs for an https TEXT_URL (private CA, self-signed server). It is a
# path INSIDE the containers: mount the file (world-readable) into router and imgfix with a compose.override.yaml
# next to compose.yaml, e.g.
#   services:
#     router: { volumes: [ "./my-ca.pem:/certs/ca.pem:ro" ] }
#     imgfix: { volumes: [ "./my-ca.pem:/certs/ca.pem:ro" ] }
# and set TEXT_CA_FILE=/certs/ca.pem. The certificate must name the TEXT_URL host (https needs a name, not an IP).
# Set with an http TEXT_URL it is a configuration error (router and imgfix exit 2).
TEXT_CA_FILE=

# Optional comma-separated model names or globs whose requests go to TEXT_URL unchanged, images included (for models
# that can see for themselves), e.g. PASSTHROUGH_MODELS='claude-*,gpt-4o*'. Default: none.
PASSTHROUGH_MODELS=

# --- Vision model: one-line captions when an image first arrives (imgfix) and ask_image answers (vision-mcp).
# VISION_API: openai     any OpenAI-compatible chat/completions endpoint that accepts image_url data URLs (vLLM,
#                        SGLang, llama.cpp, Ollama, LM Studio, OpenAI, OpenRouter, Gemini, Azure, Groq, Mistral, ...)
#             anthropic  the Anthropic Messages API (Claude)
VISION_API=openai

# Base URL. openai: a base like .../v1 (+ /chat/completions), a full .../chat/completions URL (query kept, e.g. Azure's
# ?api-version=...) or a bare host:port (+ /v1/chat/completions). anthropic: the same with /messages.
# Empty: http://host.docker.internal:8001/v1 (openai) or https://api.anthropic.com (anthropic).
VISION_BASE_URL=

# Required: the model name the vision endpoint serves (sent as "model" in every request).
VISION_MODEL=

# Optional API key: openai -> "Authorization: Bearer <key>", anthropic -> "x-api-key: <key>". Never logged.
VISION_API_KEY=

# Optional JSON object of extra request headers, applied last (so it can replace the auth header). Never logged.
VISION_HEADERS=

# openai only: max_tokens (default) | max_completion_tokens (newer OpenAI models reject max_tokens).
VISION_TOKEN_PARAM=max_tokens

# Optional JSON object merged into every vision request body (top-level keys; null deletes a key, e.g.
# {"temperature":null}; it may not set model, messages, stream or system). Invalid JSON stops imgfix and vision-mcp
# at startup with a clear error. Thinking models: turn thinking off (or down), otherwise captions (60 tokens, 8 s)
# are cut off mid-reasoning or time out, so those images get no caption, for good (captions are write-once).
VISION_EXTRA_BODY='{}'

# Examples (all lines of one example together):
#   local vLLM   VISION_BASE_URL=http://host.docker.internal:8001/v1  VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
#                VISION_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'   (Qwen3 thinking off)
#   Ollama       VISION_BASE_URL=http://host.docker.internal:11434/v1  VISION_MODEL=qwen2.5vl:7b
#   OpenAI       VISION_BASE_URL=https://api.openai.com/v1  VISION_MODEL=gpt-6-luna  VISION_API_KEY=sk-...
#                VISION_TOKEN_PARAM=max_completion_tokens  VISION_EXTRA_BODY='{"reasoning_effort":"none"}'
#                (reasoning would use up the caption's tokens, and only "none" allows a temperature)
#   Claude       VISION_API=anthropic  VISION_MODEL=claude-haiku-5-5  VISION_API_KEY=sk-ant-...
#                VISION_EXTRA_BODY='{"temperature":null,"thinking":{"type":"disabled"}}'
#                (current Claude models reject a non-default temperature; thinking would use up the caption's tokens)
#   Gemini       VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  VISION_MODEL=gemini-3.6-flash
#                VISION_API_KEY=<Gemini API key>  VISION_EXTRA_BODY='{"reasoning_effort":"minimal","temperature":null}'
#                (Gemini 3 thinking can't be turned off and uses up the caption's tokens: minimal is the lowest level,
#                which gemini-3.8-flash lacks; Google advises leaving temperature at its default)
#   OpenRouter   VISION_BASE_URL=https://openrouter.ai/api/v1  VISION_MODEL=qwen/qwen3-vl-8b-instruct
#                VISION_API_KEY=sk-or-...
#   Azure        VISION_BASE_URL='https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-10-21'
#                VISION_MODEL=<deployment>  VISION_API_KEY=  VISION_HEADERS='{"api-key":"<key>"}'

# --- What the text model sees for an image: "[image img_<id> | WxH fmt | <caption>] <hint>". All of it is fixed for
# a given configuration (same input, same bytes: prompt caches keep working).
# CAPTION_MODE: short (one sentence) | detailed (thorough description with all visible text quoted, <= ~200 words;
# for harnesses that cannot ask follow-up questions) | off (no vision call at ingest: "no preview"). A caption is
# stored once per image: a new mode applies to new images only.
CAPTION_MODE=short

# Seconds to wait for a caption at ingest. Empty: 8 (short) or 45 (detailed). A timeout means no caption, for good.
CAPTION_TIMEOUT=

# ASK_HINT: mcp  "call the ask_image tool with image_id=..." (the harness has the MCP server)
#           http "run: curl -s -G <ASK_URL> --data-urlencode image_id=... --data-urlencode "question=..."" (the
#                harness can run shell commands but has no MCP)
#           none only "The model cannot see images." (pair with CAPTION_MODE=detailed)
# The hint is not stored: changing ASK_HINT or ASK_URL changes the text for every image (one prompt-cache miss).
ASK_HINT=mcp

# Where the HARNESS reaches vision-mcp's /ask (used in the http hint). Empty: http://127.0.0.1:<MCP_PORT>/ask.
ASK_URL=

# --- Image URLs (http/https links instead of inline data). false: the model sees "remote image not fetched: <url>".
# true: each URL is fetched once, on first sight (<= 32 MiB, 10 s, 3 redirects, 8 new URLs per request) and stored
# like an inline image; the outcome is recorded so every later turn shows the same text. Only public addresses are
# fetched unless FETCH_ALLOW_PRIVATE=true (then imgfix also reaches your LAN and the Docker host: trusted clients only).
FETCH_REMOTE_IMAGES=false
FETCH_ALLOW_PRIVATE=false

# --- Published ports. The router is the address your client uses (see "Pick your harness"); vision-mcp serves MCP at
# http://127.0.0.1:8102/mcp and plain HTTP at http://127.0.0.1:8102/ask. Neither has authentication: keep BIND_ADDR on
# 127.0.0.1 unless the network is trusted. imgfix has no published port.
BIND_ADDR=127.0.0.1
ROUTER_PORT=8100
MCP_PORT=8102

# Host-header allowlist for vision-mcp's /mcp and /ask (DNS-rebinding guard), comma-separated host:port patterns ("*"
# port wildcard). Requests with any other Host header get 421. If you bind to a LAN address, add the name/IP clients
# use, e.g. 127.0.0.1:*,localhost:*,vision-mcp:*,10.0.0.5:*   A lone "*" turns the check off.
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,vision-mcp:*

# imgfix refuses to store new images/PDFs (they become "[image unavailable: could not be decoded]") while the store
# volume's filesystem has less than this many GB free. Already stored images keep working.
IMGFIX_MIN_FREE_GB=5
