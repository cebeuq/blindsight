# blindsight configuration. Copy to .env next to compose.yaml (docker compose reads it from there), edit, then:
#   docker compose up -d --build
# After changing a value: docker compose up -d   (recreates the affected containers)
# Syntax: KEY=value, no spaces around "=". Put values with spaces, "#", "$" or JSON in single quotes (taken literally).
# Variables set in your shell override this file.

# --- Text model: the text-only model server. Plain HTTP, Anthropic Messages API (POST /v1/messages).
# host.docker.internal = the Docker host (Docker Desktop; on Linux via the extra_hosts entry in compose.yaml).
# Any hostname or IP the containers can reach works; it is resolved once when the router starts.
TEXT_HOST=host.docker.internal
TEXT_PORT=8000

# --- Vision model: any OpenAI-compatible chat/completions endpoint that accepts images (image_url data URLs).
# http or https, with or without the trailing /v1. Used for one-line captions (imgfix) and ask_image (vision-mcp).
VISION_BASE_URL=http://host.docker.internal:8001/v1

# Required: the model name your vision server serves (sent as "model" in every request).
# e.g. VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
VISION_MODEL=

# Optional Bearer token for the vision endpoint (vLLM --api-key, hosted APIs). Sent by imgfix and vision-mcp as
# "Authorization: Bearer <key>"; never logged. Leave empty for none.
VISION_API_KEY=

# Optional JSON object merged into every vision request body (top-level keys; it may not set model, messages or
# stream). Invalid JSON stops imgfix and vision-mcp at startup with a clear error. Default: none ({}).
# Qwen3-style thinking models on vLLM: turn thinking off, or captions (8 s budget) and answers get slow:
#   VISION_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'
VISION_EXTRA_BODY='{}'

# --- Published ports. The router is the address your client uses (ANTHROPIC_BASE_URL=http://127.0.0.1:8100);
# the MCP endpoint is http://127.0.0.1:8102/mcp. Neither has authentication: keep BIND_ADDR on 127.0.0.1 unless the
# network is trusted. imgfix has no published port.
BIND_ADDR=127.0.0.1
ROUTER_PORT=8100
MCP_PORT=8102

# Host-header allowlist for the MCP endpoint (DNS-rebinding guard), comma-separated host:port patterns ("*" port
# wildcard). Requests with any other Host header get 421. If you bind to a LAN address, add the name/IP clients use,
# e.g. 127.0.0.1:*,localhost:*,vision-mcp:*,10.0.0.5:*   A lone "*" turns the check off.
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,vision-mcp:*

# imgfix refuses to store new images/PDFs (they become "[image unavailable: could not be decoded]") while the store
# volume's filesystem has less than this many GB free. Already stored images keep working.
IMGFIX_MIN_FREE_GB=5
